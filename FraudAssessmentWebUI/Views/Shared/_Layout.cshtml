<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FraudSignal</title>

    <style>
        :root {
            --bg: #F3F4F0;
            --panel-border: #DEDED7;
            --ink: #14171A;
            --ink-soft: #565B5F;
            --green: #1F6F54;
            --orange: #E0622E;
            --white: #FFFFFF;
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            background: var(--bg);
            color: var(--ink);
            font-family: -apple-system, "Segoe UI", Helvetica, Arial, sans-serif;
        }

        .fs-page {
            min-height: 100vh;
        }

        .fs-topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 14px 48px;
            border-bottom: 1px solid var(--panel-border);
        }

        .fs-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 600;
            font-size: 1.05rem;
            text-decoration: none;
            color: var(--ink);
        }

        .fs-brand-mark {
            background: var(--ink);
            color: var(--white);
            font-size: 0.7rem;
            font-weight: 700;
            padding: 6px 8px;
            border-radius: 4px;
            letter-spacing: 0.03em;
        }

        .fs-brand-green {
            color: var(--green);
        }

        .fs-status {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.85rem;
            color: var(--ink-soft);
        }

        .fs-status-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--green);
            display: inline-block;
        }

        .fs-hero {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            padding: 28px 48px 24px;
            gap: 32px;
            flex-wrap: wrap;
        }

        .fs-eyebrow {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 0.72rem;
            font-weight: 600;
            letter-spacing: 0.04em;
            margin-bottom: 12px;
        }

        .fs-eyebrow-green { color: var(--green); }
        .fs-eyebrow-rule { width: 32px; height: 1px; background: var(--orange); display: inline-block; }
        .fs-eyebrow-dark { color: var(--ink-soft); }

        .fs-headline {
            font-size: 1.9rem;
            line-height: 1.15;
            font-weight: 500;
            margin: 0 0 10px;
            max-width: 620px;
        }

        .fs-headline .accent {
            color: var(--green);
            font-style: italic;
        }

        .fs-subtext {
            color: var(--ink-soft);
            font-size: 0.9rem;
            max-width: 440px;
            line-height: 1.45;
        }

        .fs-step-marker {
            text-align: right;
            flex-shrink: 0;
            display: flex;
            gap: 10px;
            align-items: baseline;
        }

        .fs-step-number {
            font-size: 1.7rem;
            font-weight: 600;
            color: var(--orange);
            line-height: 1;
        }

        .fs-step-label {
            font-size: 0.72rem;
            font-weight: 600;
            color: var(--ink-soft);
            line-height: 1.3;
            letter-spacing: 0.02em;
        }

        .fs-divider {
            border: none;
            border-top: 1px solid var(--ink);
            margin: 0 48px;
        }

        .fs-body {
            display: grid;
            grid-template-columns: 1.6fr 1fr;
            gap: 0;
            padding: 24px 48px 48px;
        }

        .fs-left {
            padding-right: 48px;
            border-right: 1px solid var(--panel-border);
        }

        .fs-section-label {
            font-size: 0.72rem;
            font-weight: 600;
            letter-spacing: 0.04em;
            color: var(--green);
            margin-bottom: 14px;
        }

        .fs-section-title {
            font-size: 1.4rem;
            font-weight: 600;
            margin: 0 0 8px;
        }

        .fs-section-desc {
            color: var(--ink-soft);
            font-size: 0.92rem;
            margin-bottom: 24px;
            max-width: 480px;
        }

        .fs-dropzone {
            border: 1px dashed #B7BBB4;
            background: #EDEEE9;
            border-radius: 4px;
            padding: 36px 24px;
            text-align: center;
            cursor: pointer;
            display: block;
            transition: border-color 0.15s ease, background 0.15s ease;
        }

        .fs-dropzone:hover,
        .fs-dropzone.dragover {
            border-color: var(--green);
            background: #E6E9E2;
        }

        .fs-dropzone-icon {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: var(--green);
            color: var(--white);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            margin-bottom: 16px;
        }

        .fs-dropzone-title {
            font-weight: 600;
            font-size: 1rem;
            margin-bottom: 6px;
        }

        .fs-dropzone-sub {
            color: var(--ink-soft);
            font-size: 0.85rem;
        }

        .fs-dropzone-filename {
            color: var(--green);
            font-weight: 600;
            font-size: 0.85rem;
            margin-top: 10px;
        }

        .fs-submit {
            width: 100%;
            margin-top: 20px;
            background: var(--ink);
            color: var(--white);
            border: none;
            border-radius: 4px;
            padding: 16px 20px;
            font-size: 0.95rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: space-between;
            cursor: pointer;
            transition: background 0.15s ease;
        }

        .fs-submit:hover {
            background: #2B2F33;
        }

        .fs-submit:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .fs-right {
            padding-left: 48px;
        }

        .fs-check-item {
            padding: 18px 0;
            border-bottom: 1px solid var(--panel-border);
            display: flex;
            gap: 14px;
        }

        .fs-check-item:last-of-type {
            border-bottom: none;
        }

        .fs-check-number {
            color: var(--orange);
            font-weight: 700;
            font-size: 0.85rem;
            flex-shrink: 0;
        }

        .fs-check-title {
            font-weight: 600;
            font-size: 0.95rem;
            margin: 0 0 4px;
        }

        .fs-check-desc {
            color: var(--ink-soft);
            font-size: 0.85rem;
            line-height: 1.4;
        }

        .fs-footnote {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px solid var(--panel-border);
            font-size: 0.78rem;
            color: var(--green);
        }

        .fs-error-panel {
            margin-top: 16px;
            border: 1px solid #E0622E;
            background: #FBEDE7;
            border-radius: 4px;
            padding: 14px 16px;
        }

        .fs-error-panel p {
            margin: 0 0 4px;
            font-size: 0.85rem;
            color: #9A3A18;
        }

        .fs-error-panel p:last-child {
            margin-bottom: 0;
        }

        @@media (max-width: 900px) {
            .fs-body { grid-template-columns: 1fr; }
            .fs-left { border-right: none; padding-right: 0; border-bottom: 1px solid var(--panel-border); padding-bottom: 32px; margin-bottom: 32px; }
            .fs-right { padding-left: 0; }
            .fs-headline { font-size: 2.2rem; }
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="fs-page">
        <div class="fs-topbar">
            <a asp-controller="Home" asp-action="Index" class="fs-brand">
                <span class="fs-brand-mark">FD</span>
                <span>Fraud<span class="fs-brand-green">Signal</span></span>
            </a>
            <div class="fs-status">
                <span class="fs-status-dot"></span>
                Analysis workspace
            </div>
        </div>

        @RenderBody()
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
